"""
This Lambda function powers the "Watch Next" feature requested in the homework specifications. 
Instead of performing expensive runtime aggregations, it takes advantage of the pre-computed schema generated by AWS Glue, 
querying MongoDB by the current talk's ID to instantly extract its pre-nested array of related videos. 
"""

import json
import os
from pymongo import MongoClient

def lambda_handler(event, context):
    # Retrieves the pre-aggregated list of related videos (Watch Next) for the current talk.
    
    if isinstance(event.get('body'), str):
        body = json.loads(event['body'])
    else:
        body = event.get('body', event)
        
    current_video_id = body.get('current_video_id')
    
    if not current_video_id:
        return {
            'statusCode': 400,
            'headers': {'Content-Type': 'application/json', 'Access-Control-Allow-Origin': '*'},
            'body': json.dumps({"error": "Parametro 'current_video_id' mancante."})
        }
        
    mongo_uri = os.environ.get('MONGO_URI')
    if not mongo_uri:
        return {
            'statusCode': 500,
            'body': json.dumps({"error": "MONGO_URI non configurata."})
        }
        
    client = MongoClient(mongo_uri)
    db = client['unibg_tedx_2026']
    talks_col = db['tedx_data']
    
    # Finds the specific talk document using its primary key (_id)
    talk = talks_col.find_one({"_id": str(current_video_id)})
    
    if not talk:
        return {
            'statusCode': 404,
            'headers': {'Content-Type': 'application/json', 'Access-Control-Allow-Origin': '*'},
            'body': json.dumps({"error": "Talk non trovato."})
        }
        
    # Extracts the pre-computed structured array generated by the AWS Glue ETL job
    watch_next_list = talk.get('related_videos', [])
    
    return {
        'statusCode': 200,
        'headers': {
            'Content-Type': 'application/json',
            'Access-Control-Allow-Origin': '*'
        },
        'body': json.dumps(watch_next_list)
    }
